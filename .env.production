# 生产环境配置（仅 `pnpm build` 时由 Vite 自动加载；本地 `pnpm dev` 仍用 .env，互不影响）
#
# 部署形态：前端与后端同域（webchat.bitlesu.com 由 OpenResty 反代到后端），
# 因此 API 与 WebSocket 走【相对路径】自动适配 —— 无论用域名还是 IP 访问都能工作，
# 无需硬编码域名（域名解析未就绪时可直接用 IP 访问）。

VITE_APP_TITLE=端对端聊天室

# API 基础路径（与后端同域，保持 /api）
VITE_API_BASE_URL=/api

# WebSocket 地址：留空 = 自动用当前页面地址构造 ws(s)://<host>/ws（兼容域名/IP）
# 如需强制指定可填：wss://webchat.bitlesu.com/ws
VITE_WS_URL=

# 服务器静态资源地址（头像/媒体外链兜底）：
# 留空 = 相对路径由当前域名解析；如需绝对外链可填：https://webchat.bitlesu.com
VITE_SERVER_URL=
